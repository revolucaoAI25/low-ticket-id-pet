# URL pública do site (sem barra no final). Usada no QR Code e nos e-mails.
NEXT_PUBLIC_SITE_URL=https://clubedofocinho.com.br

# Supabase (Project Settings → API). A service role fica SÓ no servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Senha do painel /admin
ADMIN_PASSWORD=

# Token do webhook da Kiwify (aparece ao criar o webhook). Opcional, mas recomendado.
KIWIFY_WEBHOOK_TOKEN=

# E-mail de acesso (Resend). Sem isso, o acesso continua funcionando pela página de obrigado.
RESEND_API_KEY=
EMAIL_FROM="Clube do Focinho <kit@clubedofocinho.com.br>"

# Utmify → Integrações → Credenciais de API → criar credencial.
# Manda para a Utmify os pedidos à parte (order bumps e +1 pet), com as UTMs de quem fez o quiz.
# A oferta principal continua chegando pelo webhook da própria Utmify.
UTMIFY_API_TOKEN=
# Opcional: 1 = a Utmify só valida o envio, sem salvar (para testar). Apague depois.
UTMIFY_TEST=

# API de Conversões da Meta (Gerenciador de Eventos → seu pixel → Configurações → Gerar token).
# Só use se a Utmify NÃO mandar para a Meta a compra dos order bumps (senão conta em dobro).
META_CAPI_TOKEN=
# Opcional, só para testar no Gerenciador de Eventos (aba "Testar eventos"). Apague depois.
META_TEST_EVENT_CODE=
