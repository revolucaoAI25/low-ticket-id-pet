# URL pública do site (sem barra no final). Usada no QR Code e nos e-mails.
NEXT_PUBLIC_SITE_URL=https://clubedofocinho.com.br

# Supabase (Project Settings → API). A service role fica SÓ no servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Senha do painel /admin
ADMIN_PASSWORD=

# Token do webhook da Kiwify (aparece ao criar o webhook). Opcional, mas recomendado.
KIWIFY_WEBHOOK_TOKEN=

# E-mail de acesso (Resend). Sem isso, o acesso continua funcionando pela página de obrigado.
RESEND_API_KEY=
EMAIL_FROM="Clube do Focinho <kit@clubedofocinho.com.br>"
